# Frontend / web service (Railway — app.beyondcode.ai)
# Set these on the Railway WEB service (repo root), NOT the orchestrator service.

# REQUIRED: External orchestrator URL (Railway orchestrator service)
VITE_API_BASE_URL=

# REQUIRED at build time for Vite (same values as .env.local)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# REQUIRED at runtime (server.js — NOT bundled into the frontend)
APP_ACCESS_PASSWORD=
# Optional cookie signing secret (openssl rand -hex 32)
APP_SESSION_SECRET=
NODE_ENV=production

# Auto-configured by Lovable Cloud (do not change)
# VITE_SUPABASE_URL=https://dtctqwoesbvntdpeekgv.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<auto>
# VITE_SUPABASE_PROJECT_ID=dtctqwoesbvntdpeekgv
