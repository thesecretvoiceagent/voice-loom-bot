# ─────────────────────────────────────────────────────────────────────────────
# Web service (Railway — app.beyondcode.ai dashboard)
# VITE_* are build-time. Set on the Railway WEB service (repo root), not orchestrator.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED at build time
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

NODE_ENV=production
