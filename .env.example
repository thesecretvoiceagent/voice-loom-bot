# ─────────────────────────────────────────────────────────────────────────────
# App access gate — server-side only (used by server.js / the Render web service)
# These are NOT Vite (VITE_*) vars, so they are never bundled into the frontend.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED in production. Shared password to enter the BeyondCode dashboard
# at app.beyondcode.ai. If unset in production, the gate fails closed and all
# logins are rejected. Set the real value in the deployment env (Render/Railway),
# never commit it.
APP_ACCESS_PASSWORD=

# OPTIONAL. Dedicated secret used to sign the session cookie. If unset, the
# access password is used as the signing key (so rotating the password also
# logs everyone out). Generate: openssl rand -hex 32
APP_SESSION_SECRET=

# Set by the platform automatically; controls Secure cookie flag / fail-closed.
NODE_ENV=production
